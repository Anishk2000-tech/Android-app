    <!-- Setup -->
    <string name="setup_title">Welcome to WorkDeck</string>
    <string name="setup_intro">Use Microsoft Teams and Outlook on the web, with calls, notifications and desktop view. Set it up once in under a minute.</string>
    <string name="setup_step_account">1. Your Microsoft account</string>
    <string name="setup_account_work">Work or school account (Microsoft 365)</string>
    <string name="setup_account_personal">Personal account (Outlook.com, Hotmail, Live, Teams free)</string>
    <string name="setup_step_apps">2. What do you want to use?</string>
    <string name="setup_step_permissions">3. Permissions</string>
    <string name="setup_permissions_hint">Tap \"Allow everything\", then accept each Android prompt.</string>
    <string name="setup_allow_all">Allow everything</string>
    <string name="perm_mic">Microphone</string>
    <string name="perm_mic_desc">Needed to talk in Teams calls and meetings.</string>
    <string name="perm_camera">Camera</string>
    <string name="perm_camera_desc">Optional. For video in calls.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_desc">For new messages, mail and incoming calls.</string>
    <string name="perm_bluetooth">Nearby devices (Bluetooth)</string>
    <string name="perm_bluetooth_desc">Lets calls use your Bluetooth earphones or car.</string>
    <string name="perm_battery">Run in background</string>
    <string name="perm_battery_desc">Stops Android from putting WorkDeck to sleep, so notifications and calls arrive on time.</string>
    <string name="perm_fullscreen">Incoming-call screen</string>
    <string name="perm_fullscreen_desc">Shows incoming calls on the lock screen, like a phone call.</string>
    <string name="perm_oem">Phone-maker battery settings</string>
    <string name="perm_oem_desc">%1$s phones can close apps aggressively. Open app settings and allow Autostart / \"No restrictions\" for battery, and lock WorkDeck in Recents.</string>
    <string name="perm_oem_desc_generic">If notifications stop after a while, open app settings and set battery usage to \"Unrestricted\".</string>
    <string name="status_allowed">Allowed ✓</string>
    <string name="status_needed">Not allowed</string>
    <string name="status_optional">Optional</string>
    <string name="btn_allow">Allow</string>
    <string name="btn_open">Open</string>
    <string name="setup_tips_title">Good to know</string>
    <string name="setup_tips">• When Microsoft asks \"Stay signed in?\", tap Yes. You will then stay signed in, even after closing the app or restarting the phone.\n• To answer a call, tap the notification (or Answer) — Teams opens with the call.\n• Use the speaker button in the bottom bar during a call to switch between speaker, earpiece and Bluetooth.\n• Pinch to zoom, or use the zoom button. Switch desktop / mobile view with the screen button.\n• Outlook: to get mail notifications, open Outlook Settings → General → Notifications and turn on desktop notifications.</string>
    <string name="setup_continue">Start WorkDeck</string>
